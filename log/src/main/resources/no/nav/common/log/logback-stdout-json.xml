<?xml version="1.0" encoding="UTF-8"?>
<included>
    <appender name="stdout_json_masked" class="no.nav.common.log.MaskingAppender">
        <filter class="no.nav.common.log.CxfNonErrorStdoutFilter"/>
        <appender-ref ref="consoleAppender"/>
    </appender>
    <appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- Sannsynligvis legacy: Simpleclient-appender for loggtelling per nivå. Avklar forbruk før eventuell fjerning. -->
    <appender name="metrics" class="io.prometheus.client.logback.InstrumentedAppender"/>

    <root level="${ROOT_LOG_LEVEL:-INFO}">
        <appender-ref ref="stdout_json_masked"/>
        <appender-ref ref="metrics"/>
    </root>

    <!-- Tomcat-spesifikk demping av Cookie-parserlogger. Ikke relevant for apper som bruker Jetty. -->
    <logger name="org.apache.tomcat.util.http.parser.Cookie" level="OFF" />

    <logger name="org.apache" level="INFO"/>
    <logger name="org.apache.cxf" level="ERROR"/>
    <logger name="no.nav.common.cxf" level="ERROR"/>
    <logger name="org.apache.http.client.protocol.ResponseProcessCookies" level="ERROR"/>
    <logger name="org.apache.wss4j.common.crypto.CryptoBase" level="ERROR"/>
    <logger name="no.nav.common.rest.client.LogRequestInterceptor" level="DEBUG"/>
    <logger name="no.nav.common.rest.filter.LogRequestFilter" level="DEBUG"/>

</included>
